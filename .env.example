# Copie para .env e preencha. .env nunca vai para o git.

# --- Banco ---
RADAR_DB=dados/radar.db
RADAR_DIR_DADOS=dados

# --- Município alvo ---
RADAR_MUNICIPIO_IBGE=4105607

# --- Chaves de API (todas opcionais; o sistema degrada com elegância sem elas) ---
# Portal da Transparência Federal — cadastro gratuito
PORTAL_TRANSPARENCIA_TOKEN=

# --- Modelos de IA (etapa 5 e 6 da pipeline) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Operação ---
# Identificação do responsável humano. Aparece no log de revisão e é
# obrigatória para aprovar qualquer peça (AGENTS.md, regra do fluxo).
RADAR_REVISOR_NOME=
RADAR_REVISOR_EMAIL=

# Contato exposto no User-Agent dos coletores. Boa prática: se um portal
# estranhar o tráfego, que saiba com quem falar.
RADAR_CONTATO=
